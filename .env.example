# Banco de dados (Postgres do docker-compose.yml)
DATABASE_URL=postgres://lumnia:lumnia@localhost:5432/lumnia

# Better Auth. Gere um segredo com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-este-valor
BETTER_AUTH_URL=http://localhost:3000

# Opcional. Fonte Chillax (licença do Fontshare, não pode ser redistribuída).
# Informe o caminho do Chillax-Variable.woff2 baixado do Fontshare, ou uma URL privada
# (usada no build do SaaS). Sem nenhum dos dois, a aplicação usa apenas a fonte Outfit.
CHILLAX_WOFF2_PATH=
CHILLAX_WOFF2_URL=
